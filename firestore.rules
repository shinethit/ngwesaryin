rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userEmail() {
      return request.auth.token.email != null ? request.auth.token.email : '';
    }

    function userEmailLower() {
      return userEmail().lower();
    }

    // Master admin — MUST match AuthContext.tsx isMasterAdminEmail()
    function isMasterAdmin() {
      return isSignedIn() && userEmailLower() == 'khunthanshwe@gmail.com';
    }

    // Registered admin via /admins/{uid} collection
    function isRegisteredAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isMasterAdmin() || isRegisteredAdmin();
    }

    // [v7.5.56] REMOVED: isCollaborator() used to grant anyone whose
    // email was in a user's root `collaborators` array READ access to
    // that user's ENTIRE account (root doc + every subcollection).
    // Sharing one wallet must never grant access to the owner's other
    // wallets, transactions, debts, vehicles, etc. Collaborators may
    // now read ONLY: sharedWallets docs they are members of, their own
    // sharedWalletRefs, and the debts of a shared wallet they belong
    // to (see the debts rule below). The root `collaborators` array
    // grants nothing under these rules.
    function canAccess(userId) {
      return isOwner(userId) || isAdmin();
    }

    // [v6.22.0] Two-tier write permission:
    //   - canWriteOwnerOnly(userId): owner only (used by user subcollections
    //     since collaborator writes are scoped to shared wallets)
    //   - canWrite(userId): owner OR collaborator (kept for backwards
    //     compatibility but no longer wired to subcollection rules)
    function canWriteOwnerOnly(userId) {
      return isOwner(userId);
    }


    // [v6.9-phase1c] Premium field write protection.
    // A user may only upgrade their plan ONCE, and only via:
    //   Path A: first-time free trial (trialClaimed goes false->true)
    //   Path B: valid unused activation code they redeemed themselves
    // After the initial upgrade, self-writes to premium fields are blocked.
    function touchingPremiumFields(newData, oldData) {
      return newData.diff(oldData).affectedKeys().hasAny([
        'plan', 'premiumExpiresAt', 'premiumActivatedAt',
        'premiumMonths', 'premiumCodeUsed'
      ]);
    }

    function canUpgradePremium() {
      return resource.data.plan != 'premium'
        && request.resource.data.plan == 'premium'
        && (
          // [v6.17.0] Path A: first-time trial claim — hardened.
          // Requires: never previously had premium, exactly 3 months,
          // a plausible ISO timestamp, and no code claimed.
          (
            request.resource.data.trialClaimed == true
            && resource.data.get('trialClaimed', false) != true
            && resource.data.get('premiumActivatedAt', null) == null
            // [trial-fix] Allow 1-12 months (was strictly == 3).
            // claimFreeTrial may stack +3 onto an existing value if user
            // already had partial months. Allow that band without
            // opening a floodgate (still requires fresh trialClaimed).
            && request.resource.data.premiumMonths is number
            && request.resource.data.premiumMonths >= 1
            && request.resource.data.premiumMonths <= 12
            && request.resource.data.premiumExpiresAt is string
            && request.resource.data.premiumExpiresAt.size() >= 20
            && request.resource.data.premiumExpiresAt.size() <= 30
            && (
              request.resource.data.premiumCodeUsed == null
              || request.resource.data.premiumCodeUsed == ''
            )
          )
          ||
          // Path B: valid activation code owned by user — unchanged
          (
            request.resource.data.premiumCodeUsed is string
            && request.resource.data.premiumCodeUsed.size() > 0
            && exists(/databases/$(database)/documents/activationCodes/$(request.resource.data.premiumCodeUsed))
            && get(/databases/$(database)/documents/activationCodes/$(request.resource.data.premiumCodeUsed)).data.isUsed == true
            && get(/databases/$(database)/documents/activationCodes/$(request.resource.data.premiumCodeUsed)).data.usedBy == request.auth.uid
          )
        );
    }

    // Shared wallet membership check
    function isSharedWalletMember(walletId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sharedWallets/$(walletId))
        && (
          get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
          || userEmail() in get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('sharedWith', [])
          || userEmailLower() in get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('sharedWith', [])
        );
    }

    function isSharedWalletOwner(walletId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sharedWallets/$(walletId))
        && get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid;
    }

    // [v6.21.2] Flat per-action permission helpers.
    // Firestore rules don't support let bindings + chained get() inside
    // a single function body; use one expression per permission.
    function isSWOwnerOrAddIncome(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canAddIncome', false) == true;
    }
    function isSWOwnerOrAddExpense(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canAddExpense', false) == true;
    }
    function isSWOwnerOrEditIncome(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canEditIncome', false) == true;
    }
    function isSWOwnerOrEditExpense(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canEditExpense', false) == true;
    }
    function isSWOwnerOrDeleteIncome(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canDeleteIncome', false) == true;
    }
    function isSWOwnerOrDeleteExpense(walletId) {
      return get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/sharedWallets/$(walletId)).data.get('collaboratorPermissions', {}).get(userEmailLower(), {}).get('canDeleteExpense', false) == true;
    }

    // =========================================================
    // 2. COLLECTION GROUP MATCHES (Admin Analytics Only)
    // =========================================================
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    match /{path=**}/wallets/{walletId} {
      allow read: if isAdmin();
    }

    match /{path=**}/categories/{categoryId} {
      allow read: if isAdmin();
    }

    // =========================================================
    // 3. /admins/{adminId} — FIXED (was: privilege escalation)
    // =========================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isMasterAdmin();
    }

    // =========================================================
    // [v7.5.64 B-12] /adminAuditLog/{logId} — append-only admin audit trail
    // =========================================================
    match /adminAuditLog/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================
    // 4. /activationCodes/{codeId} — FIXED (was: any user can update)
    // =========================================================
    match /activationCodes/{codeId} {
      allow get: if isSignedIn();
      allow list, create, delete: if isAdmin();

      // Strict redeem-only update:
      allow update: if isSignedIn()
        && resource.data.isUsed == false
        && request.resource.data.isUsed == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.months == resource.data.months
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }

    // =========================================================
    // 5. System-wide messages / settings / config
    // =========================================================
    match /systemMessages/{messageId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /systemConfig/{configId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // 6. /feedbacks/{feedbackId}
    // =========================================================
    // [v6.9-phase1a] Feedbacks — was: anyone read/write (spam + privacy leak)
    match /feedbacks/{feedbackId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // =========================================================
    // 7. /visitors/{visitorId} — FIXED (was: anyone can read/write)
    // =========================================================
    // [v6.9-phase1a] Visitors — was: any signed-in user could list all visitor PII
    match /visitors/{visitorId} {
      // [v6.16.0] Field whitelist + immutable critical fields on update.
      allow create: if request.resource.data.country is string
        && request.resource.data.country.size() <= 100
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 8
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.device in ['mobile', 'desktop', 'tablet']
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 100
        && request.resource.data.visitCount is number
        && request.resource.data.visitCount >= 0
        && request.resource.data.visitCount <= 10000000
        && request.resource.data.firstSeenAt is number
        && request.resource.data.lastActiveAt is number;

      allow update: if request.resource.data.country == resource.data.country
        && request.resource.data.countryCode == resource.data.countryCode
        && request.resource.data.device == resource.data.device
        && request.resource.data.browser == resource.data.browser
        && request.resource.data.visitCount is number
        && request.resource.data.visitCount >= 0
        && request.resource.data.visitCount <= 10000000
        && request.resource.data.lastActiveAt is number;

      allow get, list: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // 8. /public_shops/{shopId} — FIXED (was: any user can delete)
    // =========================================================
    match /public_shops/{shopId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.addedByUid == request.auth.uid;
      // [v6.16.0] Ownership fields immutable on update.
      allow update: if isSignedIn()
        && (resource.data.addedByUid == request.auth.uid || isAdmin())
        && request.resource.data.addedByUid == resource.data.addedByUid
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn()
        && (resource.data.addedByUid == request.auth.uid || isAdmin());
    }

    // =========================================================
    // 8a. /shop_reports/{reportId} — [v7.5.81] Shop reports.
    // A signed-in user may report a shop (create) and read ONLY
    // their own reports; the Admin Panel (admin) reads all pending
    // reports and resolves/dismisses them. The dedupe query filters
    // reportedByUid == auth.uid only (single-field index, no
    // composite index) — that query is permitted by the read rule
    // below because it constrains reportedByUid to the caller.
    // =========================================================
    match /shop_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedByUid == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reportedByUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 8b. /sharedWalletRefs/{email}/wallets/{docId} — [v6.20.0] sharedWallets list disabled
    //     [v6.18.0] Per-recipient pointers so members can discover
    //     shared wallets without a collection-wide list() query.
    //     Refs contain no financial data — reader verifies the
    //     actual sharedWallets/{docId} doc via its own get rule.
    // =========================================================
    match /sharedWalletRefs/{email}/wallets/{docId} {
      // Only the owner of the email may read their refs.
      // [v7.5.64 B-03] Admins may also read refs — needed to clean up a
      // deleted user's discovery refs. Refs carry no financial data.
      allow get, list: if isSignedIn()
        && ((request.auth.token.email != null
        && request.auth.token.email.lower() == email) || isAdmin());

      // [v6.21.0] Only the owner (auth.uid == ownerUid) may create a ref.
      // Prevents fake refs pointed at arbitrary wallets or owners.
      // [v7.5.56] Split from update: the invitee may update their OWN
      // ref's status (accept), but only the owner may create a ref.
      allow create: if isSignedIn()
        && request.resource.data.docId == docId
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 128
        && request.resource.data.walletName is string
        && request.resource.data.walletName.size() <= 200
        && request.resource.data.addedAt is number;

      // Owner may update a ref they created (same field checks as create).
      allow update: if isSignedIn()
        && request.resource.data.docId == docId
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 128
        && request.resource.data.walletName is string
        && request.resource.data.walletName.size() <= 200
        && request.resource.data.addedAt is number;

      // [v7.5.56] Invitee accept: the recipient (token.email lower ==
      // the ref path email) may update ONLY the status of their own
      // ref, to 'pending' or 'accepted'. Every other field is frozen
      // by the affectedKeys check. Decline is a delete (rule below),
      // which already allows the recipient to remove their own ref.
      allow update: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status in ['pending', 'accepted'];

      // Deletion: allow the recipient to remove their own ref, or the
      // owner to clean up refs they created.
      // [v7.5.64 B-03] Admins may also delete refs (deleted-user cleanup).
      allow delete: if isSignedIn()
        && (
          (request.auth.token.email != null && request.auth.token.email.lower() == email)
          || resource.data.ownerUid == request.auth.uid
          || isAdmin()
        );
    }

    // =========================================================
    // 9. /sharedWallets/{walletId}
    // =========================================================
    match /sharedWallets/{walletId} {
      // [v6.20.0] List DISABLED. Recipients discover shared wallets via
      // the per-user sharedWalletRefs collection instead of a
      // collection-wide query. get() is still allowed for members.
      allow list: if false;

      // GET (single doc): strict membership check (walletId IS bound here).
      allow get: if isSharedWalletMember(walletId);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // [v6.21.0] Split owner vs member updates.
      // Owner can update anything (sharing, permissions, metadata).
      // [v7.5.56] That includes ownership transfer: the current owner
      // may hand the wallet to a member (see the explicit transfer
      // rule below — it only documents the transfer, the owner rule
      // already permits it; the new owner must be in sharedWith).
      allow update: if isSharedWalletOwner(walletId);

      // [v7.5.56] Ownership transfer (explicit): current owner changes
      // ownerUid/ownerEmail/ownerName to a member of the wallet.
      // Only the owner fields (plus updatedAt) may change in this write.
      // The new owner's uid comes from the doc's memberUids map
      // (lowercased email → uid), which members populate themselves —
      // the owner cannot query /users by email.
      allow update: if isSharedWalletOwner(walletId)
        && request.resource.data.ownerUid != resource.data.ownerUid
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerEmail is string
        && (request.resource.data.ownerEmail.lower() in resource.data.get('sharedWith', [])
            || request.resource.data.ownerEmail in resource.data.get('sharedWith', []))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'updatedAt']);

      // [v6.22.0] Member can ONLY update updatedAt (heartbeat).
      // Balance is now OWNER-ONLY (data integrity — see v6.21.1 review).
      // [v7.5.56] Balance is recomputed by recomputeSharedWalletBalance()
      // in sharedWalletService.ts after shared writes, not on boot.
      // Any member-created transaction triggers balance recompute on the
      // next owner app boot via computeContentFingerprint sync, so the
      // balance stays fresh without allowing direct tampering.
      allow update: if isSharedWalletMember(walletId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.collaboratorPermissions == resource.data.collaboratorPermissions
        && request.resource.data.balance == resource.data.balance;

      // [v7.5.56] Member self-leave (audit finding 1): a member may
      // update ONLY to remove their OWN email from sharedWith and
      // delete their OWN collaboratorPermissions entry (plus
      // updatedAt). Nothing else may change. Enforced by:
      //   - affectedKeys hasOnly the three fields (ownerUid, balance,
      //     name, … are all frozen);
      //   - new sharedWith is a subset of the old list, exactly one
      //     entry shorter, and no longer contains the leaver — so the
      //     single removed entry can only be the leaver themself;
      //   - new collaboratorPermissions keys are a subset of the old
      //     keys, at most one entry shorter, and no longer contain
      //     the leaver's key.
      allow update: if isSharedWalletMember(walletId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sharedWith', 'collaboratorPermissions', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('sharedWith', []).hasOnly(resource.data.get('sharedWith', []))
        && request.resource.data.get('sharedWith', []).size() == resource.data.get('sharedWith', []).size() - 1
        && !(userEmailLower() in request.resource.data.get('sharedWith', []))
        && !(userEmail() in request.resource.data.get('sharedWith', []))
        && request.resource.data.get('collaboratorPermissions', {}).keys()
            .hasOnly(resource.data.get('collaboratorPermissions', {}).keys())
        && request.resource.data.get('collaboratorPermissions', {}).size() >= resource.data.get('collaboratorPermissions', {}).size() - 1
        && !(userEmailLower() in request.resource.data.get('collaboratorPermissions', {}).keys());

      // [v7.5.56] memberUids map (lowercased email → uid): lets the
      // owner resolve a member's email to a uid for ownership transfer
      // (an ordinary owner cannot query /users by email — the rules
      // deny it). A member may update ONLY their own entry — their own
      // lowercased email mapping to their own uid — plus updatedAt.
      // Enforced by: affectedKeys hasOnly the map + updatedAt (owner
      // fields, sharedWith, balance, … are frozen); the map diff's
      // affected keys are exactly the member's own email (no other
      // entry may be added, changed, or deleted); and the member's own
      // entry must equal their own uid (it cannot point at anyone
      // else, and it cannot be deleted — the get() would return '').
      // The owner may write the map freely under the owner update rule
      // above (e.g. pruning it as part of a transfer).
      allow update: if isSharedWalletMember(walletId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('memberUids', {}).get(userEmailLower(), '') == request.auth.uid
        && request.resource.data.get('memberUids', {}).diff(resource.data.get('memberUids', {})).affectedKeys()
            .hasOnly([userEmailLower()]);

      allow delete: if isSharedWalletOwner(walletId) || isAdmin();

      // [v6.21.2] Per-type shared tx rules use flat permission helpers.
      // Transfers are treated as expense (matches client model).
      match /transactions/{transactionId} {
        allow list, get: if isSharedWalletMember(walletId);

        allow create: if isSharedWalletMember(walletId)
          && request.resource.data.id == transactionId
          && request.resource.data.walletId == walletId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type == 'income'
          && isSWOwnerOrAddIncome(walletId);
        allow create: if isSharedWalletMember(walletId)
          && request.resource.data.id == transactionId
          && request.resource.data.walletId == walletId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type in ['expense', 'transfer']
          && isSWOwnerOrAddExpense(walletId);

        // [v7.5.56] Type-flip guard (audit finding 7): the OLD type is
        // validated as well as the new one. A member may change a
        // transaction only if they hold the edit permission for BOTH
        // the old type and the new type — canEditIncome alone must not
        // flip an expense into income (and vice versa). Owners pass
        // both helpers unconditionally (see isSWOwnerOrEdit*).
        allow update: if isSharedWalletMember(walletId)
          && request.resource.data.walletId == walletId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type == 'income'
          && isSWOwnerOrEditIncome(walletId)
          && ((resource.data.type == 'income' && isSWOwnerOrEditIncome(walletId))
              || (resource.data.type in ['expense', 'transfer'] && isSWOwnerOrEditExpense(walletId)));
        allow update: if isSharedWalletMember(walletId)
          && request.resource.data.walletId == walletId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type in ['expense', 'transfer']
          && isSWOwnerOrEditExpense(walletId)
          && ((resource.data.type == 'income' && isSWOwnerOrEditIncome(walletId))
              || (resource.data.type in ['expense', 'transfer'] && isSWOwnerOrEditExpense(walletId)));

        allow delete: if isSharedWalletMember(walletId)
          && resource.data.type == 'income'
          && isSWOwnerOrDeleteIncome(walletId);
        allow delete: if isSharedWalletMember(walletId)
          && resource.data.type in ['expense', 'transfer']
          && isSWOwnerOrDeleteExpense(walletId);
      }

      // [v7.5.56] Debts mirror (audit finding 21, decision 17): debts
      // on a shared wallet are mirrored to this subcollection so
      // members can see them read-only. Only the owner or the debt's
      // creator may write; everyone else reads.
      match /debts/{debtId} {
        allow list, get: if isSharedWalletMember(walletId);

        allow create: if isSharedWalletMember(walletId)
          && request.resource.data.id == debtId
          && request.resource.data.sharedWalletId == walletId
          && (isSharedWalletOwner(walletId)
              || request.resource.data.createdBy == request.auth.uid);

        allow update: if isSharedWalletMember(walletId)
          && request.resource.data.sharedWalletId == walletId
          && (isSharedWalletOwner(walletId)
              || resource.data.createdBy == request.auth.uid);

        allow delete: if isSharedWalletMember(walletId)
          && (isSharedWalletOwner(walletId)
              || resource.data.createdBy == request.auth.uid);
      }
    }

    // =========================================================
    // 10. /users/{userId} and all subcollections
    // =========================================================
    // [v6.9-phase1b] Split read vs write and validate payloads.
    //   ROOT doc:  owner/master admin write; owner/admin read only
    //   SUBS:      owner write; owner/admin read only — EXCEPT debts,
    //              which a shared-wallet member may read when the debt
    //              belongs to a wallet they are a member of (v7.5.56).
    //              The root `collaborators` array grants NOTHING.
    //   Validation: userId must match path; id (where present) must
    //               match doc; amount/type constrained on transactions.
    // =========================================================
    match /users/{userId} {
      // ----- Root user document -----
      // [admin-fix] Split get vs list for admin query-ability.
      // Single-doc reads keep the original rule (owner/admin only —
      // [v7.5.56] collaborators no longer get any access here).
      // Collection LIST queries need a rule Firestore can pre-evaluate:
      //   - admin: list all users
      //   - self: list own doc
      // [v7.5.56] The old collaborator list branch (email in the root
      // `collaborators` array) is REMOVED — that array grants nothing.
      allow get: if canAccess(userId);
      allow list: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
      // [v6.16.0] Prevent self-registration with 'premium' plan.
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && (
          request.resource.data.plan in ['free', 'guest']
          || isMasterAdmin()
        );
      // [v6.9-phase1c] Owner can update non-premium fields freely.
      // Premium upgrades must satisfy canUpgradePremium().
      // Master admin bypass for manual support.
      allow update: if isMasterAdmin()
        || (
          isOwner(userId)
          && (
            !touchingPremiumFields(request.resource.data, resource.data)
            || canUpgradePremium()
          )
        );
      allow delete: if isMasterAdmin();

      // ----- Transactions -----
      // [v6.16.0] Amount/type/walletId/date validation also on UPDATE
      match /transactions/{transactionId} {
        allow read: if canAccess(userId);
        allow create: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && request.resource.data.walletId is string
          && request.resource.data.walletId.size() > 0
          && request.resource.data.walletId.size() <= 128
          && request.resource.data.date is string
          && request.resource.data.date.size() >= 8
          && request.resource.data.date.size() <= 30;
        allow update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 999999999999
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && request.resource.data.walletId is string
          && request.resource.data.walletId.size() > 0
          && request.resource.data.walletId.size() <= 128
          && request.resource.data.date is string
          && request.resource.data.date.size() >= 8
          && request.resource.data.date.size() <= 30;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Debts -----
      // [v7.5.56] Debts are the ONE users/{uid} subcollection a shared-
      // wallet member may read: only debts whose walletId belongs to a
      // shared wallet they are a member of. The walletId on a debt is
      // the owner's local wallet id, so the shared doc id is
      // {ownerUid}_{walletId} (or the walletId already is a shared doc
      // id). Every other subcollection below is owner/admin only via
      // canAccess(). Writes stay owner-only.
      match /debts/{debtId} {
        allow read: if canAccess(userId)
          || (isSignedIn()
              && resource.data.walletId is string
              && (isSharedWalletMember(resource.data.walletId)
                  || isSharedWalletMember(userId + '_' + resource.data.walletId)));
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == debtId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Wallets -----
      match /wallets/{walletId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == walletId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Categories -----
      match /categories/{categoryId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == categoryId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Budgets (doc id = categoryId, no id field required) -----
      match /budgets/{budgetId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Savings Targets -----
      match /savingsTargets/{targetId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Shops -----
      match /shops/{shopId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == shopId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Vehicles -----
      match /vehicles/{vehicleId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == vehicleId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Fuel Logs -----
      match /fuelLogs/{fuelLogId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == fuelLogId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Vehicle Maintenance -----
      match /vehicleMaintenance/{maintenanceId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == maintenanceId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }

      // ----- Tire Pressure Logs -----
      match /tirePressureLogs/{logId} {
        allow read: if canAccess(userId);
        allow create, update: if canWriteOwnerOnly(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == logId;
        allow delete: if canWriteOwnerOnly(userId) || isAdmin();
      }
    }
  }
}